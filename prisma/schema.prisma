generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String         @id @default(cuid())
  name          String
  staleDays     Int            @default(7)
  createdAt     DateTime       @default(now())
  members       Member[]
  documents     Document[]
  activityLogs  ActivityLog[]
  notifications Notification[]
}

model Member {
  id                String    @id @default(cuid())
  projectId         String
  name              String
  email             String
  // Allowed values: OWNER, ADMIN, MEMBER, VIEWER, CLIENT
  role              String    @default("MEMBER")
  project           Project   @relation(fields: [projectId], references: [id])
  assignedDocuments Document[] @relation("AssignedDocuments")
}

model Document {
  id               String           @id @default(cuid())
  projectId        String
  title            String
  // Allowed values: DRAFT, IN_REVIEW, FINAL, SENT
  status           String           @default("DRAFT")
  dueDate          DateTime?
  assignedMemberId String?
  tagsJson         String           @default("[]")
  stale            Boolean          @default(false)
  lastActivityAt   DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  project          Project          @relation(fields: [projectId], references: [id])
  assignedMember   Member?          @relation("AssignedDocuments", fields: [assignedMemberId], references: [id])
  versions         DocumentVersion[]
  activityLogs     ActivityLog[]
  notifications    Notification[]
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  versionNumber Int
  filePath      String
  fileHash      String
  fileSize      Int
  changeNote    String
  createdAt     DateTime @default(now())
  actorName     String
  document      Document @relation(fields: [documentId], references: [id])
}

model ActivityLog {
  id          String   @id @default(cuid())
  projectId   String
  documentId  String?
  ts          DateTime @default(now())
  actorName   String
  eventType   String
  message     String
  payloadJson String   @default("{}")
  project     Project  @relation(fields: [projectId], references: [id])
  document    Document? @relation(fields: [documentId], references: [id])
}

model Notification {
  id         String   @id @default(cuid())
  projectId  String
  documentId String?
  ts         DateTime @default(now())
  actorName  String
  type       String
  message    String
  isRead     Boolean  @default(false)
  project    Project  @relation(fields: [projectId], references: [id])
  document   Document? @relation(fields: [documentId], references: [id])
}
